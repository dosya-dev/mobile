{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "production-apk": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "DOSYA_DIST_CHANNEL": "direct"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "support@dosya.dev",
        "ascAppId": "6796702157",
        "appleTeamId": "53HFF44WQ8"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "appleId": "support@dosya.dev",
        "ascAppId": "6796702157",
        "appleTeamId": "53HFF44WQ8"
      }
    }
  }
}
