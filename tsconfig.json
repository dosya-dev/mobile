{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@dosya-dev/e2ee-core": ["vendor/e2ee-core"],
      "@dosya-dev/e2ee-client": ["vendor/e2ee-client"],
      "@dosya-dev/personas-engine": ["vendor/personas-engine"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}