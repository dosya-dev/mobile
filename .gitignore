# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# gradle build output inside expo modules (not covered by the /android ignore above)
modules/*/android/build/

# Firebase config for Android push. Supplied to EAS as a file environment
# variable (GOOGLE_SERVICES_JSON) rather than committed - see app.config.ts.
google-services.json
